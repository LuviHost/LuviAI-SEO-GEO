# ════════════════════════════════════════════════════════════════
#  RanksUp — Environment Configuration
#  Bu dosyayı `.env` olarak kopyalayıp gerçek değerlerle doldurun
#
#  DIKKAT: aciklamayi degerin yanina (KEY=deger  # not) YAZMAYIN. Uretimde
#  pm2 (ecosystem.config.cjs) .env'i kendi okur ve satir ici yorumu SILMEZ:
#  "PAYTR_TEST_MODE=1  # 1=test" surece "1  # 1=test" olarak gecer; kodun
#  '1' karsilastirmalari tutmaz ve PayTR'a gecersiz test_mode gider
#  (billing/paytr.service.ts). Bu dosyadaki tum aciklamalar bu yuzden ayri satirda.
# ════════════════════════════════════════════════════════════════

# ─── DATABASE ───────────────────────────────────────────────
# Yerel: docker-compose ile gelen MySQL
DATABASE_URL="mysql://luviai:luviai_dev@localhost:3306/luviai"
REDIS_URL="redis://localhost:6379"

# Şifrelenmiş alan AES-256 key (FTP/SSH credentials için)
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── API SERVERS ────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
# Web portu env'den okunmaz: apps/web package.json "next dev/start -p 3000",
# uretimde pm2 PORT=3000.

# Production'da:
# API_BASE_URL=https://api.ranksup.ai
# WEB_BASE_URL=https://ranksup.ai

# ─── AUTH (NextAuth) ────────────────────────────────────────
# NEXTAUTH_URL'i next-auth kutuphanesi kendisi okur (AUTH_URL ile ayni is)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (kullanıcı login + GSC erişimi) — web'de tek giriş yolu
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth callback: https://ranksup.ai/api/auth/callback/google

# Mobil native Google girisi: API (POST /api/auth/mobile/google) idToken audience'ini bunlarla dogrular; mobil env okumaz, iOS/Web ID'leri mobile/src/authConfig.ts ile ayni olmali
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# ─── AI PROVIDERS ───────────────────────────────────────────
# Anthropic Claude (yazar/editör/diğer ajanlar)
ANTHROPIC_API_KEY=

# Google Gemini (görsel + opsiyonel metin)
GOOGLE_AI_API_KEY=

# Makale ajan modelleri — platform geneli, müşteri başına seçilmez.
# Boş bırakılan: ajanın koddaki tercihi, yoksa ROUTING_MODEL, o da yoksa
# claude-sonnet-5 (apps/api/src/articles/agent-runner.service.ts)
WRITER_MODEL=claude-sonnet-4-6
EDITOR_MODEL=claude-sonnet-4-6
ROUTING_MODEL=claude-sonnet-4-6
# Kapak görseli sağlayıcısı. Geçerli değerler ve gereken anahtarlar:
# apps/api/src/articles/image-generator.service.ts (dispatchProvider).
# Seçilen sağlayıcı hata verirse gemini-flash'a düşülür.
IMAGE_PROVIDER=gemini-flash

# ─── AI GÖRÜNÜRLÜK ÖLÇÜMÜ (RanksUp anahtarları) ─────────────
# Ölçüm motoru her sağlayıcıyı önce müşterinin kendi anahtarıyla (BYOK,
# Kurumsal plan), yoksa buradaki RanksUp anahtarıyla ölçer
# (apps/api/src/audit/citation-providers.ts POOL_ENV_KEY). Anahtar boşsa o
# sağlayıcı ölçülmez; panel "Ölçülmüyor — RanksUp anahtarı tanımlı değil" der.
# Claude = ANTHROPIC_API_KEY, Gemini = GOOGLE_AI_API_KEY (yukarıda),
# Grok = XAI_API_KEY (INTEL bölümünde).
# OPENAI_API_KEY: ChatGPT ölçümü; gpt-image-1 görselleri ve GEO ısı haritası da kullanır
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
# Meta AI (Llama) Groq üzerinden ölçülür: anahtar VE model ikisi de gerekir.
# Model boşsa Llama hiç çağrılmaz (citation-providers.ts llamaModelConfigured).
GROQ_API_KEY=
GROQ_LLAMA_MODEL=
# Gunluk otomatik AI olcumu (worker AI_CITATION_DAILY, her gun 04:00 UTC).
# VARSAYILAN KAPALI: tum sitelerde her gun LLM cagrisi demek, yani otomatik
# harcama. Olcumu kullanici baslatir (kayan 7 gunde 1). Acikca 'true'
# yazilmadikca calismaz.
AI_CITATION_DAILY_CRON=false

# ─── GOOGLE SEARCH CONSOLE ──────────────────────────────────
# Multi-tenant: her kullanıcı kendi GSC OAuth token'ını verir
# Bu sadece API'a izinli scope tanımı:
GSC_SCOPES=https://www.googleapis.com/auth/webmasters.readonly

# ─── INTEL — SEKTOR ISTIHBARATI (ic arac, /admin/intel) ─────
# GEO/SEO/ASO kaynaklarini tarar, iddia defteri tutar, ozet uretir.
# Hicbiri zorunlu degil: anahtarsiz da calisir (X kaynaklari atlanir,
# ozet yalnizca panelde kalir).
#
# false yapilirsa tum intel cron'lari durur (acil kapatma anahtari)
INTEL_ENABLED=true
# Gunluk/haftalik ozetin gonderilecegi adres. Bos ise e-posta atilmaz.
# Admin panelden INTEL_DIGEST_TO ayariyla da verilebilir.
INTEL_DIGEST_TO=
# Tur basina islenecek azami kayit — maliyet freni.
# Triage ve analiz GUNDE TEK TUR calistigi icin bunlar ayni zamanda
# gunluk tavandir (analiz boru hattinin en pahali ucu).
INTEL_TRIAGE_LIMIT=200
INTEL_ANALYZE_LIMIT=30
# X (Twitter) taramasi — BIRINCIL yol: OpenClaw + gercek tarayici.
# Sunucudaki yonetilen Chromium profili X'e giris yapmis oturumla arama
# yapar ve postlardaki GitHub depolarini da inceler. Kurulum:
# docs/OPENCLAW-KURULUM.md
OPENCLAW_ENABLED=
# API root, OpenClaw ayri kullanicida kurulu — arada sudo koprusu var
OPENCLAW_BIN=/usr/local/bin/openclaw-ranksup
# Ajan kimligi; bos birakilirsa gateway'in varsayilan ajani kullanilir
OPENCLAW_AGENT=
# Gateway baska makinedeyse WS adresi; yereldeyse bos birak
OPENCLAW_GATEWAY_URL=
OPENCLAW_TOKEN=
# Tek ajan turu icin saniye. Tarayici gezmesi + depo incelemesi yavas.
OPENCLAW_TIMEOUT_SEC=420

# X taramasi — YEDEK yol: xAI Live Search. OpenClaw bos donerse devreye
# girer. Ikisi de yoksa X kaynaklari sessizce atlanir, sistem calisir.
# Ayni anahtar AI gorunurluk olcumunde Grok icin de kullanilir (POOL_ENV_KEY xai).
XAI_API_KEY=
XAI_MODEL=grok-4
# Model secimi admin panel ayarlarindan yapilir (kod fallback'i yanlarinda):
#   MODEL_INTEL_TRIAGE   → ucuz eleme  (varsayilan claude-haiku-4-5)
#   MODEL_INTEL_ANALYST  → kanit cikarimi (varsayilan claude-opus-5)

# ─── HAFTALIK PLAN — ZAMANLANMIS TESLIM ─────────────────────
# Pazartesi 06:00 (TR) "Bu haftanin plani" chat skill'ini aktif sitelerde
# calistirir; sonuc Aksiyon Plani + bildirim + e-posta olarak teslim edilir.
#
# VARSAYILAN KAPALI: her site bir agent dongusu (Sonnet + tool turlari)
# demek, yani otomatik harcama. Acikca 'true' yazilmadikca calismaz —
# INTEL_CRON'dan farki bu (o kapali degilse calisir).
WEEKLY_PLAN_CRON=false
# Tur basina islenecek azami site — maliyet freni. Tavani asan siteler
# ATLANIR ve kac tanesi atlandigi loglanir (sessiz kirpma yok).
# Secim sahip bazinda sirayla yapilir: bir ajansin onlarca sitesi tavani
# doldurup tek siteli musterileri ac birakmasin.
WEEKLY_PLAN_MAX_SITES=50

# ─── META (FACEBOOK + INSTAGRAM) ADS ────────────────────────
# https://developers.facebook.com/apps/
# App Mode: Live'a almak icin Privacy Policy + Terms + Data Deletion URL zorunlu.
# Advanced scope'lar (ads_management, pages_manage_ads, business_management,
# instagram_content_publish) icin App Review + Business Verification zorunlu.
META_APP_ID=
META_APP_SECRET=
# Webhook URL'leri (Meta App Dashboard → Facebook Login → Settings'e ekle):
#   Valid OAuth Redirect URIs:    https://ranksup.ai/api/oauth/meta-ads/callback
#   Deauthorize Callback URL:     https://ranksup.ai/api/oauth/meta-ads/deauthorize
#   Data Deletion Request URL:    https://ranksup.ai/api/oauth/meta-ads/data-deletion

# ─── GOOGLE ADS API ─────────────────────────────────────────
# Surum: apps/api/src/ads/google-ads-api.ts (GOOGLE_ADS_API_VERSION, su an v26;
# kapanis Kasim 2027 — https://developers.google.com/google-ads/api/docs/sunset-dates).
# Developer token 9 Eylul 2026'da kaldirildi; GOOGLE_ADS_DEV_TOKEN artik okunmuyor.
# Erisim seviyesi GOOGLE_CLIENT_ID'nin Google Cloud projesinde: Cloud Console >
# Google Ads API Overview. Test erisimi yalniz test hesaplarina acik; gercek
# hesaplar icin Explorer/Basic/Standard gerekir.
# MCC (manager) hesabin musteri ID'si (tireler olmadan, ornek: 1955591888).
# Musteriler kendi Google hesaplariyla baglaniyorsa BOS birakin (aksi halde
# Google istekleri USER_PERMISSION_DENIED ile reddedebilir).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ─── REKLAM OTOPILOTU — BUTCE EMNIYETI ve KAMPANYA SKORU ────
# Reklam otopilotu bütçe emniyeti (apps/api/src/ads/budget-guard.ts) — varsayılan:
# kampanya başına 24 saatte 1, 7 günde 2 artış; tavan = otopilotun ilk
# değiştirdiği andaki bütçenin 2 katı; geçersiz değer yok sayılır (bir kez
# uyarı loglanır, varsayılan kullanılır). Panel sayıları API'den okur; SSS'teki
# reklam cevabı (apps/web/src/app/(marketing)/faq/page.tsx) varsayılanları
# anlatır, değiştirirsen onu da güncelle. Değer satırına yorum ekleme (üstteki DIKKAT).
# İki artış arası en az saat (1-720)
# ADS_BUDGET_INCREASE_COOLDOWN_HOURS=24
# Kayan 7 günde en fazla artış (0-28; 0 = artış yok)
# ADS_BUDGET_MAX_INCREASES_PER_WEEK=2
# Tavan çarpanı: taban bütçe x bu değer (1-10)
# ADS_BUDGET_MAX_MULTIPLIER=2
# Kampanya Skoru LLM hakemi (apps/api/src/ads/ads-audit.service.ts adsAuditModel)
# ADS_AUDIT_MODEL=claude-opus-5

# ─── APPLE ADS (ASA) ────────────────────────────────────────
# Apple Ads API surumu: v5 (Campaign Management API — Apple 26 Ocak 2027'de kapatiyor) | platform (Apple Ads Platform API)
ASA_API_VERSION=v5

# ─── SIGN IN WITH APPLE ─────────────────────────────────────
# BUNDLE_ID mobil Apple girisi icin sart; hesap silmede Apple token iptali dordunu de ister (eksikse iptal atlanir, silme yine tamamlanir)
APPLE_IOS_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=

# ─── PAYTR (TR ÖDEME) ────────────────────────────────────────
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test, 0 = canlı ödeme. Değer PayTR isteğine ve hash'e aynen girer.
PAYTR_TEST_MODE=1
# Bildirim (webhook) adresi icin ortam degiskeni YOK: kod adresi hicbir PayTR istegine
# koymaz (istekte yalniz asagidaki merchant_ok_url / merchant_fail_url var). PayTR adresi
# yalniz kendi panelinden alir: Magaza Paneli > Destek & Kurulum > Ayarlar > Bildirim URL
# Ayarlari (dev.paytr.com/iframe-api/iframe-api-2-adim). Panele girilecek adres:
# https://api.ranksup.ai/api/billing/webhooks/paytr
# (billing.controller.ts @Controller('billing') + @Post('webhooks/paytr'), main.ts 'api' oneki).
# Eski PAYTR_NOTIFICATION_URL degiskeni kaldirildi; sunucu .env'inde kalmasi zararsiz.
PAYTR_OK_URL=https://ranksup.ai/billing/success
PAYTR_FAIL_URL=https://ranksup.ai/billing/failure
# Otomatik yenileme (billing/paytr.service.ts recurringEnabled): yalniz tam '1' acar; bos,
# '0' ya da baska her deger KAPALI. Acikken satin alma iFrame yerine Direkt API ile kart
# saklayarak yapilir (createDirectCheckout) ve yenileme cron'u kayitli karttan ceker
# (renewal-policy.ts). PayTR magaza hesabinda Direkt API, Non3D ve tekrarlayan odeme
# yetkisi ACILMADAN 1 yapmayin; kapaliyken iFrame akisi aynen calisir.
PAYTR_RECURRING_ENABLED=0
# Kayitli karttan yenileme cekiminde (chargeStoredCard; musteri tarayicisi yok) PayTR
# istegine user_ip olarak giden adres. Tanimsiz ya da bos ise 127.0.0.1 gider;
# kullanacaksaniz API sunucusunun genel IP adresini yazin.
# PAYTR_SERVER_IP=

# ─── EMAIL ──────────────────────────────────────────────────
RESEND_API_KEY=
# Yalnız adres yaz (ad ekleme): admin doğrulama e-postası bunu
# "RanksUp Admin <EMAIL_FROM>" diye sarar (apps/web/src/lib/admin-otp.ts).
# Alan adı Resend'de doğrulanmış olmalı (docs/EMAIL-ALAN-ADI.md).
EMAIL_FROM=noreply@ranksup.ai

# ─── MONITORING ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── SECURITY ───────────────────────────────────────────────
# Genel istek sınırı (ThrottlerModule, API süreci başına bellekte tutulur):
# RATE_LIMIT_WINDOW_MS penceresinde (ms) en fazla RATE_LIMIT_MAX istek.
# Varsayılan 60000 ms (1 dakika) içinde 60 istek.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# CORS (web → api)
CORS_ORIGINS=http://localhost:3000,https://ranksup.ai

# Musteri sitesi / webhook / render vekili baglantilari IPv4'e sabit (varsayilan acik). Calisan IPv6 yolu olan sunucuda 0 yapin.
# SAFE_FETCH_IPV4_ONLY=1

# API + worker surec geneli IPv4 sabitlemesi (DNS ipv4first + happy-eyeballs kapali + API undici family=4). Calisan IPv6 yolu olan sunucuda 1 yapin.
# 1 / true / on / yes sabitlemeyi kapatir (apps/api/src/ipv4-pin.ts).
# ALLOW_IPV6=0

# Ücretsiz AI görünürlük kontrolü (landing + mobil uygulama, kimliksiz uç):
# IP başına 24 saatte en fazla bu kadar FARKLI alan adı (varsayılan 3;
# geçersiz değer yok sayılır). Ortak IP arkasındakiler (ofis NAT, mobil
# operatör CGNAT) bu hakkı paylaşır; meşru kullanıcılar 429 alıyorsa artır.
# Turnstile token'sız mobil istek en fazla 2 alır (bu değer daha düşükse o).
# PUBLIC_CITATION_IP_DAILY_LIMIT=3

# Müşteri sitelerine gömülü persona sohbet widget'ı: site başına günlük toplam
# mesaj (varsayılan 300; pozitif tam sayı olmayan değer yok sayılır). Ayrıca
# ziyaretçi + site başına 10 dakikada 20 mesaj sabit. Sınır dolunca o sitenin
# widget'ı 24 saatlik pencere bitene kadar 429 döner. Bu sayaç API süreci başına
# bellekte (apps/api/src/audit/persona-chat-throttler.guard.ts) ve yeniden
# başlatmada sıfırlanır; ücretli model çağrısının asıl tavanı veritabanındaki
# (kv_store) kalıcı günlük sayaçlardır: site başına aynı değer ve tüm siteler
# toplamı. Toplam dolunca widget'lar kibar bir "bugünlük sınır" yanıtı verir.
# PERSONA_CHAT_SITE_DAILY_LIMIT=300
# PERSONA_CHAT_GLOBAL_DAILY_LIMIT=3000

# ─── ÇALIŞMA ORTAMI ─────────────────────────────────────────
NODE_ENV=development

# TEST: 1 = onboarding chain icindeki tier-1 schedule + GENERATE_ARTICLE handler + PROCESS_SCHEDULED cron atlanir (LLM/image API harcama yok). Production = 0 veya hic.
# Env yalniz ilk acilista app_settings'te satiri yoksa tohum degeridir; sonra
# admin Ayarlar sayfasindaki deger gecerli (settings.service onModuleInit, getRaw).
ARTICLE_GENERATION_DISABLED=0

# ─── MAILJET — kurumsal kampanya ────────────────────────────
# Mailjet — kurumsal kampanya gonderimi (apps/api/scripts/prospect/06-mailjet.ts). Gonderici alan adi Mailjet'te dogrulanmis olmali.
MAILJET_API_KEY=
MAILJET_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=RanksUp
MAILJET_REPLY_TO=

# ─── KULLANILMIYOR — kod okumuyor (18.10.2026, grep ile dogrulandi) ──────
# Onceki ornekte vardi; apps/, packages/, mobile/, scripts/ ve
# ecosystem.config.cjs bu adlari okumuyor (yalniz yorumlarda, docs/ altinda
# ve "artik kullanilmiyor" diyen testlerde geciyor). Uretim .env'inde
# duruyorsa silinebilir, zararsizdir:
#   FEATURE_PAYMENT_REQUIRED, FEATURE_AUTO_FIRST_ARTICLE, FEATURE_WHITE_LABEL,
#   FEATURE_PUBLIC_API, FEATURE_MULTI_LANG
#   PLAN_STARTER_*, PLAN_PRO_*, PLAN_AGENCY_*, PLAN_TRIAL_DAYS
#     (fiyat ve kotalar apps/api/src/billing/plans.ts + QuotaService.LIMITS)
#   GEO_CLI_PATH, GEO_OPTIMIZER_ENABLED (GEO analizi uygulama ici, CLI cagrilmiyor)
#   LOG_LEVEL, DEBUG (DEBUG'i yalniz "debug" npm paketi okur), WEB_PORT, COOKIE_DOMAIN
#   GOOGLE_ADS_DEV_TOKEN (Google Ads developer token 9 Eylul 2026'da kaldirildi)
#   EMAIL_SERVER_HOST, EMAIL_SERVER_PORT, EMAIL_SERVER_USER, EMAIL_SERVER_PASSWORD
#     (web girisi yalniz Google; e-posta Resend API ile)
#   STORAGE_PROVIDER, STORAGE_LOCAL_PATH, S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY,
#   S3_SECRET_KEY, S3_REGION
#   TIKTOK_*, INSTAGRAM_*, YOUTUBE_*, FACEBOOK_APP_*, THREADS_*, PINTEREST_*
#   PEXELS_API_KEY, GCP_PROJECT_ID, GOOGLE_APPLICATION_CREDENTIALS, RUNWAY_API_KEY,
#   HEYGEN_*, ELEVENLABS_API_KEY, SORA_ENABLED, FFMPEG_BIN, VIDEO_OUTPUT_DIR,
#   VIDEO_PUBLIC_BASE (sosyal medya ve video uretimi 0db5a1c ile kaldirildi)
#   GOOGLE_INDEXING_SA_JSON (Google Indexing API artik cagrilmiyor),
#   WIKIDATA_BOT_USER, WIKIDATA_BOT_PASS (Wikidata'ya otomatik gonderim yok)
