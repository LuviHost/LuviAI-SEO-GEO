{
  "name": "luviai",
  "version": "0.1.0",
  "private": true,
  "description": "RanksUp — SEO + GEO Otomasyon Platformu (LuviHost ürünü)",
  "author": "Emirhan Burgazli <emirhanburgazli@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "cd apps/api && pnpm prisma migrate dev",
    "db:seed": "cd apps/api && pnpm prisma db seed",
    "db:studio": "cd apps/api && pnpm prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.20.0",
    "globals": "^17.6.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3"
  },
  "pnpm": {
    "overrides": {
      "google-play-scraper": "^10.1.3"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "cpu-features",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "protobufjs",
      "sharp",
      "ssh2"
    ],
    "patchedDependencies": {
      "aso-v2@2.0.14": "patches/aso-v2@2.0.14.patch"
    }
  }
}
