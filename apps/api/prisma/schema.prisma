// ═══════════════════════════════════════════════════════════════

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  siteId    String?
  type      String // article_generated, audit_run, ...
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("usage_events")
}

/// Gerçek müşteri testimonial'ı — dashboard'dan toplanır, admin onaylar, landing'de gösterilir.
model Testimonial {
  id     String  @id @default(cuid())
  /// Panelden yorum bırakan user. Dışarıdan alınan referanslarda NULL olur.
  userId String?
  /// Panel kullanıcısı olmayan referanslar için görünen ad — ör. bir müşteri
  /// firmanın kurucusu. Doluysa listPublic user tablosuna hiç bakmaz.
  /// NOT: bu alan doluyken kayıt, kişinin YAZILI ONAYI alınmadan
  /// approved=true yapılmamalıdır; aksi halde uydurma referans olur.
  authorName String?
  siteId     String? // hangi siteden (opsiyonel)
  rating     Int // 1-5
  body       String    @db.Text // 1-500 karakter
  role       String? // "Kurucu", "Pazarlama Müdürü" — user'ın kendi yazdığı
  company    String? // şirket / site adı
  metric     String? // "ASA CPI %40 düştü" gibi spesifik kazanım (opsiyonel)
  approved   Boolean   @default(false) // admin onaylamadan landing'de gözükmez
  approvedAt DateTime?
  approvedBy String? // hangi admin onayladı (userId)
  rejected   Boolean   @default(false)
  featured   Boolean   @default(false) // landing'de öne çıkanlar arasında mı
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([approved, featured, createdAt])
  @@index([userId])
  @@map("testimonials")
}

/// Landing page + onboarding funnel için anonim event tracking.
/// PostHog/Plausible yerine kendi datamızı tutuyoruz (KVKK uyumlu, IP yok).
model LandingEvent {
  id        String   @id @default(cuid())
  type      String // pageview, cta_click, section_view, scroll_depth, signup_complete
  path      String? // / , /pricing, /signin vs
  sessionId String // anonymous session (cookie/localStorage)
  meta      Json? // { ctaId, sectionId, scrollPct, ... }
  referrer  String?  @db.Text
  ua        String?  @db.Text // user agent
  utm       Json? // { source, medium, campaign }
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([createdAt])
  @@map("landing_events")
}

