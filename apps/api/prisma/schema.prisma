// ═══════════════════════════════════════════════════════════════
//  ADS MANAGER (Faz 11) — Google Ads + Meta Ads campaign tracking
// ═══════════════════════════════════════════════════════════════

model AdCampaign {
  id     String @id @default(cuid())
  siteId String

  platform   String // google_ads | meta_ads
  externalId String? // platform-side campaign ID (Google: 123, Meta: act_123)
  name       String
  objective  String // traffic | leads | conversions | brand_awareness | sales
  status     String  @default("DRAFT") // DRAFT | PAUSED | ACTIVE | ENDED | FAILED

  // Targeting
  audience  Json? // { interests, demographics, lookalikes, keywords (Google) }
  locations Json? // ["TR", "İstanbul", ...]
  languages Json? // ["tr", "en"]

  // Creatives
  headlines    Json? // [{ text, length }] — Google RSA
  descriptions Json? // [{ text }]
  primaryTexts Json? // Meta primary text variants
  ctaButton    String? // SHOP_NOW | LEARN_MORE | SIGN_UP

  // Images / Videos
  creativeAssets Json? // [{ url, format: square|portrait|landscape, type: image|video }]

  // Budget
  budgetType     String? // daily | lifetime
  budgetAmount   Decimal?  @db.Decimal(10, 2) // TL
  budgetCurrency String    @default("TRY")
  startDate      DateTime?
  endDate        DateTime?

  // Performance (cron her 6 saat update)
  impressions          Int       @default(0)
  clicks               Int       @default(0)
  spend                Decimal   @default(0) @db.Decimal(10, 2)
  conversions          Int       @default(0)
  ctr                  Float     @default(0)
  cpc                  Float     @default(0)
  roas                 Float     @default(0)
  performanceCheckedAt DateTime?
  performanceMetrics   Json?

  // Otopilot kararlari
  autopilotActions Json? // [{ time, action, reason }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, platform])
  @@index([siteId, status])
  @@map("ad_campaigns")
}

model AiCrawlerHit {
  id     String @id @default(cuid())
  siteId String

  date        DateTime @db.Date
  bot         String // GPTBot | ClaudeBot | PerplexityBot | Google-Extended | ...
  hits        Int      @default(0) // gunluk istek sayisi
  uniqueUrls  Int      @default(0) // farkli URL sayisi
  topUrls     Json // [{ url, count }] top 10
  status2xx   Int      @default(0) // basarili istek
  status4xx   Int      @default(0) // hatali istek
  status5xx   Int      @default(0)
  bytesServed Int      @default(0)

  createdAt DateTime @default(now())

  @@unique([siteId, date, bot])
  @@index([siteId, date])
  @@index([siteId, bot, date])
  @@map("ai_crawler_hits")
}

// ═══════════════════════════════════════════════════════════════
//  JOBS (BullMQ — async work)
// ═══════════════════════════════════════════════════════════════

model Job {
  id     String  @id @default(cuid())
  userId String
  siteId String?

  type     JobType
  status   JobStatus @default(QUEUED)
  priority Int       @default(0)

  payload  Json
  result   Json?
  error    String? @db.Text
  attempts Int     @default(0)

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  // BullMQ link
  bullJobId String? @unique

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([userId, queuedAt])
  @@map("jobs")
}

enum JobType {
  SITE_AUDIT
  AUTO_FIX
  BRAIN_GENERATE
  TOPIC_ENGINE
  GENERATE_ARTICLE
  PUBLISH_ARTICLE
  GENERATE_IMAGE
  IMPROVE_PAGE
  WEEKLY_BATCH
  PERFORMANCE_CHECK // 30 gün sonra GSC
  ONBOARDING_CHAIN // brain → audit → topics → ilk makale
  SOCIAL_PUBLISH // tek bir SocialPost yayini (cron tetikler)
  PROCESS_SCHEDULED // scheduledAt <= now olan SCHEDULED makaleleri uretime alir (cron)
  LLMS_FULL_BUILD // tum site icerigini llms-full.txt'e konsolide et (haftalik)
  AI_CITATION_DAILY // gunluk Claude/Gemini/OpenAI/Perplexity gorunurluk testi
  CONTENT_PIVOT_CHECK // 30 gun sonra dusuk performans tespit + revize tetikle (haftalik)
  AI_MENTION_ALARM // gunluk: AI citation drop tespit + email
  ADS_AUTOPILOT // 6 saatte bir: aktif kampanyalari ROAS'a gore optimize
  VIDEO_GENERATE // Faz 12: SLIDESHOW/VEO/RUNWAY/HEYGEN/SORA video uretim job tipi
  STUCK_PAGE_DETECT // Tek site: GSC bazli stuck page tarama
  STUCK_PAGE_DETECT_ALL // Cron: tum autopilot sitelerinde tarama + otomatik recovery dispatch
  STUCK_PAGE_RECOVER // Tek stuck sayfa icin LLM tabanli recovery
  STUCK_PAGE_PERFORMANCE_CHECK // 30 gun sonra GSC re-check + recovery effectiveness olcumu
  STUCK_PAGE_EXTERNAL_RECOVER // RanksUp disinda yazilan sayfa icin HTML fetch + LLM + adapter publish
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

// ═══════════════════════════════════════════════════════════════
//  BILLING (PayTR)
// ═══════════════════════════════════════════════════════════════

model Invoice {
  id     String @id @default(cuid())
  userId String

  paytrTransactionId String?       @unique
  /** Tahsil edilen tutar — PayTR TL ile calisir, bu alan TL'dir */
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("TRY")
  /** Fiyatin kanonik hali (USD). Fiyat listesi USD bazli tutulur. */
  amountUsd          Decimal?      @db.Decimal(10, 2)
  /** Siparis anindaki TCMB USD/TRY kuru — fatura/denetim icin sabitlenir */
  fxRate             Decimal?      @db.Decimal(12, 4)
  status             InvoiceStatus @default(PENDING)

  description String?
  invoiceUrl  String? // E-fatura PDF URL'i

  paidAt    DateTime?
  failedAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ═══════════════════════════════════════════════════════════════
