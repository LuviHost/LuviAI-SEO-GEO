// (Eski Faz 3 ApiKey placeholder modeli kaldirildi — Sprint C'de yukaridaki ApiKey modeli kullaniliyor)

// ─────────────────────────────────────────────────────────────────
// Sosyal Medya — kanal + post + recurring slot
// PublishTarget'a paralel ama sosyal kanal bazli (LI/X/FB/IG/TT/YT/Threads/BS/Pin/GMB)
// ─────────────────────────────────────────────────────────────────

model SocialChannel {
  id        String            @id @default(cuid())
  siteId    String
  type      SocialChannelType
  name      String // "LuviHost LinkedIn" gibi kullanici etiketi
  isActive  Boolean           @default(true)
  isDefault Boolean           @default(false) // makale yayini sonrasi otomatik dagit (opt-in)

  // OAuth + credentials (sifrelenmis JSON)
  credentials String @db.Text // encrypt(JSON.stringify({ accessToken, refreshToken, expiresAt, ... }))
  config      Json? // kanal-bazli ek ayar: pageId, ugcUrn, accountId

  // Account metadata (UI'da gostermek icin)
  externalId     String? // LI URN, FB Page ID, IG Business Account ID
  externalName   String? // "Emirhan Burgazli" / "LuviHost Co."
  externalAvatar String? @db.VarChar(1000) // LinkedIn CDN URL'leri 500+ karakter olabiliyor

  lastUsedAt DateTime?
  lastError  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site           Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  posts          SocialPost[]
  recurringSlots SocialRecurringSlot[]

  @@unique([siteId, type, externalId]) // ayni site icin ayni kanal+hesap iki kez eklenmesin
  @@index([siteId])
  @@index([type])
  @@map("social_channels")
}

enum SocialChannelType {
  LINKEDIN_PERSONAL
  LINKEDIN_COMPANY
  X_TWITTER
  FACEBOOK_PAGE
  INSTAGRAM_BUSINESS
  TIKTOK
  YOUTUBE
  THREADS
  BLUESKY
  PINTEREST
  GMB // Google Business Profile
  MASTODON
}

model SocialPost {
  id        String  @id @default(cuid())
  channelId String
  articleId String? // makaleden tureyense bagli, bagimsizsa null

  // Icerik (kanal-formati uygulanmis)
  text      String @db.Text // ana metin
  mediaUrls Json? // [{url, type:'image'|'video', altText}]
  metadata  Json? // hashtags, mentions, link, threadParts

  // Scheduling
  status       SocialPostStatus @default(DRAFT)
  scheduledFor DateTime? // null = "hemen" veya manuel
  publishedAt  DateTime?

  // Yayin sonucu
  externalId  String? // LI urn, X tweet id, FB post id
  externalUrl String? // public URL (https://linkedin.com/feed/update/urn:li:...)
  errorMsg    String? @db.Text
  retryCount  Int     @default(0)

  // Approval workflow (Brightbean parity) — opsiyonel; sadece NEEDS_APPROVAL flow'unda kullanilir
  approvedBy   String? // user id (approve eden)
  approvedAt   DateTime?
  rejectedBy   String?
  rejectedAt   DateTime?
  rejectReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  article Article?      @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([channelId, status])
  @@index([scheduledFor])
  @@index([articleId])
  @@map("social_posts")
}

enum SocialPostStatus {
  DRAFT // taslak — kullanici onaylamadi
  NEEDS_APPROVAL // takim icindeki onaylayicilar bekleniyor
  APPROVED // onaylandi, scheduledFor varsa QUEUED'a gecer
  QUEUED // zamanlanmis, scheduledFor bekleniyor
  PUBLISHING // yayina gonderiliyor
  PUBLISHED // basariyla yayinlandi
  FAILED // yayin basarisiz, retry edilebilir
  CANCELED // kullanici iptal etti
  REJECTED // approval reddedildi
}

// Haftalik recurring slot — "her Pazartesi 09:00 LI'ye queue'dan 1 post"
model SocialRecurringSlot {
  id        String @id @default(cuid())
  channelId String

  dayOfWeek Int // 0 (Pazar) - 6 (Cumartesi)
  hour      Int // 0-23
  minute    Int // 0-59
  timezone  String @default("Europe/Istanbul")

  // Slot ne yapsin?
  source   SocialSlotSource @default(QUEUE) // QUEUE: kullanici taslagindan ilk siradakini cek; AUTO: 09-social-writer ile yeni uret
  isActive Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("social_recurring_slots")
}

enum SocialSlotSource {
  QUEUE // kullanici draft'larindan al
  AUTO // 09-social-writer ile yeni uret
}

// Faz 11.4 — Generic key-value store (AI cost counter, daily quota, vb.)
model KvStore {
  key       String    @id
  value     String    @db.Text
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([expiresAt])
  @@map("kv_store")
}

// AppSetting — runtime degistirilebilen operasyonel/plan/model ayarlari.
// Secret olmayan, admin panelden yonetilen anahtarlar. Settings cache i 30sn TTL,
// degisiklik audit log a yazilir. Eski .env degerlerinden goc edildi.
model AppSetting {
  key         String   @id // ARTICLE_GENERATION_DISABLED, PLAN_PRO_PRICE, vb.
  value       String   @db.Text // hep string olarak saklanir, type alanı kasti yorumla
  type        String // "boolean" | "int" | "string" | "enum"
  category    String // "toggle" | "plan" | "model" | "limit"
  description String?  @db.Text // admin panelde gosterilen aciklama
  updatedAt   DateTime @updatedAt
  updatedBy   String? // user id

  @@index([category])
  @@map("app_settings")
}

// SettingAuditLog — kim, hangi anahtari, ne zaman, neye degistirdi.
model SettingAuditLog {
  id        String   @id @default(cuid())
  key       String // AppSetting.key
  oldValue  String?  @db.Text
  newValue  String   @db.Text
  changedBy String // user id
  changedAt DateTime @default(now())
  userAgent String?  @db.Text
  ipAddress String?

  @@index([key, changedAt])
  @@index([changedBy, changedAt])
  @@map("setting_audit_logs")
}

// ═══════════════════════════════════════════════════════════════
//  VIDEO FACTORY (Faz 12 — çoklu sağlayıcı video üretim hattı)
// ═══════════════════════════════════════════════════════════════

model Video {
  id        String  @id @default(cuid())
  siteId    String
  articleId String?

  // Source content
  title       String
  description String? @db.Text
  scriptText  String? @db.LongText // TTS için kullanılan senaryo

  // Generation params
  provider    VideoProvider
  status      VideoStatus   @default(PENDING)
  durationSec Int?
  aspectRatio String        @default("9:16") // 9:16 | 16:9 | 1:1
  voiceId     String? // ElevenLabs voice id veya OpenAI voice
  language    String        @default("tr")

  // Output
  videoUrl     String? @db.VarChar(1000)
  thumbnailUrl String? @db.VarChar(1000)
  fileSize     Int?

  // Job tracking
  jobId    String? // BullMQ job id
  errorMsg String?  @db.Text
  costUsd  Decimal? @db.Decimal(10, 4)

  // Provider-specific raw data
  providerJobId String? // Veo operation name, Runway task id, etc.
  providerRaw   Json?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([articleId])
  @@map("videos")
}

enum VideoStatus {
  PENDING
  GENERATING
  READY
  FAILED
  PUBLISHED
}

enum VideoProvider {
  SLIDESHOW // ffmpeg + stock görseller + TTS — sunucuda, ücretsiz
  VEO // Google Veo 3 (Vertex AI / Gemini)
  RUNWAY // Runway Gen-3 / Gen-4
  HEYGEN // HeyGen avatar video
  SORA // OpenAI Sora
}

// ═══════════════════════════════════════════════════════════════
//  ADS AUDIT — claude-ads (MIT) port'u
// ═══════════════════════════════════════════════════════════════

model AdsAudit {
  id       String @id @default(cuid())
  siteId   String
  platform String // 'google' | 'meta'
  industry String @default("saas")

  totalScore Int // 0-100
  grade      String // 'A' | 'B' | 'C' | 'D' | 'F'
  byCategory Json // { conversion: { score, weight }, waste: {...}, ... }
  findings   Json // [{ ruleId, name, category, severity, verdict, finding, recommendation, isQuickWin, fixTimeMinutes }]
  summary    Json // { pass, warning, fail, na, total }
  ranAt      DateTime @default(now())
  durationMs Int?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, platform, ranAt])
  @@map("ads_audits")
}

// ═══════════════════════════════════════════════════════════════
//  TOKEN USAGE — LibreChat Transaction modelinin Prisma karşılığı
// ═══════════════════════════════════════════════════════════════

model TokenUsageRecord {
  id        String  @id @default(cuid())
  siteId    String?
  userId    String?
  provider  String // 'anthropic' | 'openai' | 'gemini'
  model     String // 'claude-opus-4-7' | 'gpt-4o' | 'gemini-2.5-pro'
  tokenType String // 'prompt' | 'completion' | 'cache_read' | 'cache_write'
  context   String? // 'article-writer' | 'snippet-optimizer' | 'ads-audit-llm' | ...

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)

  rate    Decimal @db.Decimal(18, 8) // USD per 1M tokens (active rate)
  costUsd Decimal @db.Decimal(18, 8) // Σ(tokens × rate)

  conversationId String? // article id, audit id vs.
  messageId      String?

  createdAt DateTime @default(now())

  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([userId, createdAt])
  @@index([provider, model, createdAt])
  @@map("token_usage_records")
}

// ═══════════════════════════════════════════════════════════════
//  ASO — App Store Optimization
//  Kullanılan kütüphaneler: aso-v2, google-play-scraper, app-store-scraper
//  Algoritma esinlenmesi: asolytics, app-agent (AI patterns)
// ═══════════════════════════════════════════════════════════════

model TrackedApp {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // App identifiers — en az birinin dolu olması gerek
  appStoreId  String? // iTunes app id (örn. "6444904356")
  playStoreId String? // Google Play package (örn. "com.example.app")

  // Display
  name      String
  category  String?
  iconUrl   String? @db.Text
  developer String?

  // Country / locale
  country String @default("tr") // tr | us | de | ...

  // Latest metadata (snapshot from last fetch)
  metadata      Json? // { ios: {...}, android: {...} }
  lastFetchedAt DateTime?

  // Stats (latest)
  iosRating          Float?
  iosReviewCount     Int?
  androidRating      Float?
  androidReviewCount Int?

  isActive Boolean @default(true)

  // Relations
  keywords   TrackedAppKeyword[]
  reviews    AppReview[]
  // App Prompt Lab — AI asistanlarda app onerisi takibi
  geoPrompts GeoPrompt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, appStoreId, playStoreId, country])
  @@index([siteId])
  @@map("tracked_apps")
}

model TrackedAppKeyword {
  id           String     @id @default(cuid())
  trackedAppId String
  trackedApp   TrackedApp @relation(fields: [trackedAppId], references: [id], onDelete: Cascade)

  keyword String
  store   AppStore // IOS | ANDROID

  // aso-v2 scoring (0-100)
  popularity Float? // search volume proxy
  difficulty Float? // competition score
  traffic    Float? // popularity / difficulty heuristic
  // Ek skor: bizim hesapladığımız (app-agent pattern: AI relevance)
  relevance  Float?

  /// Magazanin otomatik tamamlamasi bu terimi oneriyor mu.
  ///
  /// TALEP SKORUNDAN (popularity) AYRI TUTULUYOR cunku farkli bir sey olcuyor:
  /// popularity "bu terimde siralanan uygulamalar ne kadar buyuk", bu ise
  /// "insanlar terimi yazarken magaza tamamliyor mu". Ikisini tek sayida
  /// birlestirmek, ayni sutunun satirdan satira farkli sey anlatmasi olurdu.
  /// null = olculemedi.
  suggested Boolean?

  // Latest rank (cron tarafından güncellenir)
  currentRank   Int? // 1-100, null = top 100 dışı
  previousRank  Int?
  bestRank      Int? // ever achieved
  lastCheckedAt DateTime?

  // Source — kullanıcı manuel mi, AI öneri mi
  source KeywordSource @default(MANUAL)

  isActive Boolean @default(true)

  rankings AppRanking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trackedAppId, keyword, store])
  @@index([trackedAppId, isActive])
  @@map("tracked_app_keywords")
}

enum AppStore {
  IOS
  ANDROID
}

enum KeywordSource {
  MANUAL // Kullanıcı ekledi
  AI_SUGGESTED // app-agent pattern — AI önerdi
  COMPETITOR // Rakip metadata'sından çıkarıldı
  AUTOCOMPLETE // Store suggestions'dan
}

model AppRanking {
  id                  String            @id @default(cuid())
  trackedAppKeywordId String
  trackedAppKeyword   TrackedAppKeyword @relation(fields: [trackedAppKeywordId], references: [id], onDelete: Cascade)

  position     Int? // 1-100, null = top 100 dışı
  totalResults Int? // toplam kaç sonuç vardı

  checkedAt DateTime @default(now())

  @@index([trackedAppKeywordId, checkedAt])
  @@map("app_rankings")
}

model AppReview {
  id           String     @id @default(cuid())
  trackedAppId String
  trackedApp   TrackedApp @relation(fields: [trackedAppId], references: [id], onDelete: Cascade)

  store      AppStore
  externalId String // store-side review id
  rating     Int // 1-5
  title      String?   @db.Text
  text       String    @db.Text
  author     String?
  reviewDate DateTime?

  // LLM analysis
  sentiment ReviewSentiment? // POSITIVE | NEUTRAL | NEGATIVE
  topics    Json? // ["bug", "ui", "pricing", ...]
  aiSummary String?          @db.Text

  fetchedAt DateTime @default(now())

  @@unique([trackedAppId, store, externalId])
  @@index([trackedAppId, sentiment])
  @@map("app_reviews")
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// ─────────────────────────────────────────────────────────────────
//  ASO Faz 1 — Apple Search Ads (ASA) Entegrasyonu
// ─────────────────────────────────────────────────────────────────
//
//  Apple'in Search Ads API'si: https://developer.apple.com/documentation/apple_search_ads
//  Auth: ES256 JWT (Issuer ID + Key ID + .p8 private key) → Bearer token
//  Endpoint: https://api.searchads.apple.com/api/v5
//
//  AsaAccount: kullanıcının App Store Connect → Keys'den oluşturduğu Search Ads API key.
//  Bir site birden fazla ASA hesabına sahip olabilir (örn. iOS + iPad ayrı Apple ID).
//

model AsaAccount {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Apple Search Ads API credentials (encrypted at rest)
  orgId        String // Apple Organization ID (numeric)
  keyId        String // Apple Key ID
  encryptedKey String  @db.Text // .p8 private key, AES-256-GCM encrypted
  teamId       String? // opsiyonel — multi-team hesaplar için

  // Auth state
  tokenCacheValue String?   @db.Text // last issued JWT (cache; 180 day expiry)
  tokenCacheExpAt DateTime?

  // Status
  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  lastError  String?   @db.Text

  // ── Auto-Pilot (Seviye 2) ─────────────────────────
  autoPilotEnabled    Boolean   @default(false)
  autoPilotBudgetCap  Float? // USD/ay — aşılırsa yeni kampanya açılmaz
  autoPilotLastRunAt  DateTime?
  autoPilotLastResult String?   @db.Text // JSON: { added: [...], paused: [...], skipped: [...] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns AsaCampaign[]

  @@index([siteId])
  @@map("asa_accounts")
}

model AsaCampaign {
  id        String     @id @default(cuid())
  accountId String
  account   AsaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Apple-side identifiers
  asaCampaignId      String  @unique // Apple'ın verdiği numeric ID (string olarak tutuyoruz)
  name               String
  budget             Float // daily budget USD
  totalBudget        Float? // opsiyonel — toplam kampanya bütçesi
  status             String // ENABLED | PAUSED | DELETED | DRAFT
  countriesOrRegions Json // ["US", "TR", ...]
  supplySources      Json // ["APPSTORE_SEARCH_RESULTS", "APPSTORE_SEARCH_TAB", "APPSTORE_TODAY_TAB", "APPSTORE_PRODUCT_PAGES"]
  appAdamId          String? // hedef Apple App ID (TrackedApp.appleId ile bağlantı)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adGroups    AsaAdGroup[]
  performance AsaPerformanceDaily[]

  @@index([accountId])
  @@map("asa_campaigns")
}

model AsaAdGroup {
  id         String      @id @default(cuid())
  campaignId String
  campaign   AsaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  asaAdGroupId     String  @unique // Apple'ın verdiği ID
  name             String
  defaultBidAmount Float // adgroup default bid USD
  status           String // ENABLED | PAUSED
  targetingType    String? // EXACT | BROAD (Apple)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keywords AsaKeywordBid[]

  @@index([campaignId])
  @@map("asa_ad_groups")
}

model AsaKeywordBid {
  id        String     @id @default(cuid())
  adGroupId String
  adGroup   AsaAdGroup @relation(fields: [adGroupId], references: [id], onDelete: Cascade)

  asaKeywordId String @unique
  keyword      String
  bidAmount    Float // USD CPT bid
  matchType    String // EXACT | BROAD
  status       String // ACTIVE | PAUSED | REJECTED

  // RanksUp metadata — AI bid optimizer için
  aiSuggestedBid  Float? // AI'ın önerdiği optimal bid
  lastOptimizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adGroupId])
  @@index([keyword])
  @@map("asa_keyword_bids")
}

model AsaPerformanceDaily {
  id         String      @id @default(cuid())
  campaignId String
  campaign   AsaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  date           DateTime @db.Date
  impressions    Int      @default(0)
  taps           Int      @default(0)
  installs       Int      @default(0)
  reattributions Int      @default(0)
  spendUsd       Float    @default(0)
  avgCpt         Float? // average cost per tap
  avgCpa         Float? // average cost per install
  ttr            Float? // tap-through rate (taps / impressions)
  conversionRate Float? // installs / taps

  createdAt DateTime @default(now())

  @@unique([campaignId, date])
  @@index([campaignId, date])
  @@map("asa_performance_daily")
}

// ─────────────────────────────────────────────────────────────────
//  ASO Faz 2 — App Store Connect API (Release Tracking)
// ─────────────────────────────────────────────────────────────────
//
//  ASC API: https://developer.apple.com/documentation/appstoreconnectapi
//  Auth: ES256 JWT (Issuer ID + Key ID + .p8) — ASA'dan FARKLI key, ayrı oluşturulur
//

model AscAccount {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  issuerId     String // App Store Connect Issuer ID
  keyId        String
  encryptedKey String @db.Text // .p8 encrypted

  tokenCacheValue String?   @db.Text
  tokenCacheExpAt DateTime?

  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  lastError  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apps AscApp[]

  @@index([siteId])
  @@map("asc_accounts")
}

model AscApp {
  id        String     @id @default(cuid())
  accountId String
  account   AscAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  appleAppId    String  @unique // Apple App ID (numeric, store URL'inde olan)
  bundleId      String
  name          String
  primaryLocale String?

  // Latest release snapshot
  latestVersion   String?
  latestReleaseAt DateTime?
  latestBuildAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  releases AscRelease[]
  alerts   AscReleaseAlert[]

  @@index([accountId])
  @@map("asc_apps")
}

model AscRelease {
  id    String @id @default(cuid())
  appId String
  app   AscApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  appleReleaseId String    @unique
  versionString  String
  buildNumber    String?
  releaseType    String? // MANUAL | AFTER_APPROVAL | SCHEDULED
  state          String // READY_FOR_SALE, PREPARE_FOR_SUBMISSION, IN_REVIEW, vs.
  releaseDate    DateTime?

  createdAt DateTime @default(now())

  @@index([appId, releaseDate])
  @@map("asc_releases")
}

model AscReleaseAlert {
  id    String @id @default(cuid())
  appId String
  app   AscApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  severity        String // INFO | WARN | CRITICAL
  message         String    @db.Text
  daysSinceUpdate Int // alert tetiklendiği anki gün sayısı
  acknowledgedAt  DateTime?
  acknowledgedBy  String?

  createdAt DateTime @default(now())

  @@index([appId, acknowledgedAt])
  @@map("asc_release_alerts")
}

// ─────────────────────────────────────────────────────────────────
//  ASO Faz 3 — RanksUp iOS SDK (Remote Config + Rating Prompt)
// ─────────────────────────────────────────────────────────────────
//
//  iOS app'ler LuviAISDK ile init eder: RanksUp.initialize(apiKey, appKey)
//  SDK her açılışta /sdk/v1/config/:appKey endpoint'inden remote config çeker.
//  Server-side rating prompt rule'larına göre SDK prompt'u açar veya açmaz.
//

model SdkAppConfig {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  appKey          String @unique // SDK init'te kullanılan public key
  encryptedSecret String @db.Text // backend → API auth için

  // Remote config payload (SDK'nın okuyacağı)
  ratingPromptRules Json? // [{ trigger, minOpens, minDays, abVariants: [...] }]
  remoteConfig      Json? // arbitrary key-value, A/B test variants

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SdkEvent[]

  @@index([siteId])
  @@map("sdk_app_configs")
}

model SdkEvent {
  id       String       @id @default(cuid())
  configId String
  config   SdkAppConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  deviceId   String // anonymized
  eventName  String
  properties Json?
  sessionId  String?
  appVersion String?
  osVersion  String?
  timestamp  DateTime @default(now())

  @@index([configId, eventName, timestamp])
  @@map("sdk_events")
}

// ASO-spesifik prompt kategorisi (PromptCategory enum'a ekleme yapmadık,
// PromptTemplate kullanır, kategori = GENERAL ama tag ile filtrelenebilir)

// ─────────────────────────────────────────────────────────────────────────
//  BRIGHTBEAN PARITY — Social Inbox + Media Library + Idea Board + Notifications
// ─────────────────────────────────────────────────────────────────────────

/// Media Library — yeniden kullanılabilir görseller/videolar (slot-bağımsız).
/// Adapter'lar farklı boyut/format gerektirdiği için variants[] otomatik üretilir.
model SocialMediaAsset {
  id     String  @id @default(cuid())
  userId String
  siteId String? // site-spesifik veya kullanici geneli (null)

  // Storage
  url        String // public URL (local /public/social-media veya S3)
  thumbnail  String? // 256x256 küçük preview
  variants   Json? // [{label:"og-1200x630", url, w, h}]
  filename   String
  mimeType   String // image/png, video/mp4
  sizeBytes  Int
  width      Int?
  height     Int?
  durationMs Int? // video icin

  // Organization
  folder  String? @db.VarChar(255) // "campaigns/q1-2026" gibi nested path
  altText String? @db.Text
  tags    Json? // ["product","lifestyle","ugc"]

  // Source
  source      MediaSource @default(UPLOAD) // UPLOAD | UNSPLASH | AI_GENERATED | URL_IMPORT
  externalRef String? // unsplash id, prompt id vs

  // Usage
  usageCount Int       @default(0) // kac postta kullanildi
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([userId, folder])
  @@index([siteId, folder])
  @@index([siteId, source])
  @@map("social_media_assets")
}

enum MediaSource {
  UPLOAD
  UNSPLASH
  AI_GENERATED
  URL_IMPORT
}

/// In-app + email notification — onay bekleyen post, gelen DM, yayın başarısızlığı vb.
model Notification {
  id     String @id @default(cuid())
  userId String

  type  NotificationType
  title String
  body  String?          @db.Text
  link  String? // tıklanınca gidilecek route

  // Polymorphic ref
  refKind String? // "social_post" | "social_inbox" | "social_idea"
  refId   String?

  // Channel selection
  channels Json @default("[\"inapp\"]") // ["inapp","email"]

  readAt      DateTime?
  emailSentAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, type])
  @@map("notifications")
}

enum NotificationType {
  SOCIAL_POST_NEEDS_APPROVAL
  SOCIAL_POST_PUBLISHED
  SOCIAL_POST_FAILED
  SOCIAL_INBOX_NEW_DM
  SOCIAL_INBOX_NEW_MENTION
  SOCIAL_INBOX_NEW_COMMENT
  SOCIAL_IDEA_ASSIGNED
  AUDIT_COMPLETE
  AI_CITATION_DROP
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────
//  STUDIO — multi-modal AI içerik üretim history (image / video / text)
// ─────────────────────────────────────────────────────────────────────────

/// Studio modülünde üretilen her image/video/text taslak burada saklanır.
/// Geçmiş listesi, favoriler, tekrar kullanma için kalıcı history.
model StudioAsset {
  id        String          @id @default(cuid())
  siteId    String
  userId    String? // owner; null olabilir (admin/system üretimi)
  type      StudioAssetType // IMAGE | VIDEO | TEXT
  prompt    String          @db.Text
  provider  String // gemini-flash | gpt-image-1 | flux-pro | claude-haiku-4-5 ...
  url       String? // image/video için public URL
  text      String?         @db.Text // TEXT tipinde generated content
  metadata  Json? // { width, height, sizeBytes, costUsd, tokens, brandColor, format, ... }
  favorite  Boolean         @default(false)
  createdAt DateTime        @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, type, createdAt])
  @@index([siteId, favorite])
  @@map("studio_assets")
}

enum StudioAssetType {
  IMAGE
  VIDEO
  TEXT
}

// ═══════════════════════════════════════════════════════════════
//  VIDEO CREDIT ADD-ON (2026-05 Premium Pricing)
//  Plan başına aylık video kotası dolduğunda kullanıcı ek paket satın alabilir.
//  Paketler: 5 video ₺499, 20 video ₺1.799, 50 video ₺3.999.
//  Kullanım: önce plan kotası, dolunca credit havuzundan düş.
// ═══════════════════════════════════════════════════════════════

model VideoCreditPurchase {
  id             String            @id @default(cuid())
  userId         String
  packSize       Int // 5 | 20 | 50
  priceTry       Int // 499 | 1799 | 3999
  status         VideoCreditStatus @default(PENDING) // PENDING → PAID → CONSUMED
  merchantOid    String?           @unique // PayTR order ref
  paytrInvoiceId String?
  creditsTotal   Int // = packSize (satın alma anında snapshot)
  creditsUsed    Int               @default(0)
  expiresAt      DateTime? // null = ömür boyu, opsiyonel 12 ay sonra expire
  paidAt         DateTime?
  createdAt      DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([merchantOid])
  @@map("video_credit_purchases")
}

enum VideoCreditStatus {
  PENDING // PayTR yönlendirme bekleniyor
  PAID // Ödeme alındı, kullanım hakkı aktif
  CONSUMED // creditsUsed == creditsTotal
  REFUNDED // İade edildi
  EXPIRED // expiresAt geçti, kalan kullanılmadı
}

// ──────────────────────────────────────────────────────────
// PUBLIC AI CITATION CHECK — Landing demo + history snapshots
// Anonim ziyaretciler /api/v1/public/citation-check'i cagirir.
// Her test ayri row → domain geçmisi tutulur, retest cron buradan
// before/after delta ureterek subscriber'lara email yollar.
// ──────────────────────────────────────────────────────────
model PublicCitationCheck {
  id          String   @id @default(cuid())
  domain      String // host (kobipratik.com) — artik unique degil
  brand       String // tespit edilen marka adi
  niche       String? // niche-detector'dan
  customNiche String? // 'diger' ise spesifik etiket
  result      Json // tum LLM responses + aggregate
  totalCalls  Int      @default(0) // kac LLM call yapildi (telemetri)
  costUsd     Float    @default(0) // toplam maliyet (telemetri)
  ip          String? // talep eden IP (hash) — audit + rate-limit
  /**
   * Hangi sebeple olusturuldu: manual (ziyaretci), retest_cron (otomatik 15/30/60/90g), signup_baseline
   */
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain, createdAt])
  @@index([createdAt])
  @@map("public_citation_checks")
}

// ──────────────────────────────────────────────────────────
// PUBLIC CITATION SUBSCRIBER — email-based retest abonelik
// Ziyaretci test sonucunda email birakir → cron'a alinir,
// 15/30/60/90g otomatik retest + branded rapor email gonderilir.
// ──────────────────────────────────────────────────────────
model PublicCitationSubscriber {
  id               String    @id @default(cuid())
  email            String // ziyaretci emaili
  domain           String // test edilen domain
  brand            String // o anki tespit edilen marka
  niche            String? // o anki niche
  customNiche      String?
  status           String    @default("PENDING_OPTIN") // PENDING_OPTIN | ACTIVE | UNSUBSCRIBED | BOUNCED | SIGNED_UP
  /**
   * KVKK consent timestamp — modal'da explicit checkbox tiklendi
   */
  consentAt        DateTime?
  /**
   * Double-opt-in token (welcome email confirm link)
   */
  confirmToken     String?   @unique
  confirmedAt      DateTime?
  /**
   * Unsubscribe link icin token
   */
  unsubscribeToken String    @unique
  /**
   * Bir sonraki retest ne zaman (cron buna bakar)
   */
  nextRetestAt     DateTime?
  /**
   * Kac retest tamamlandi (15/30/60/90 → 4 max)
   */
  retestsSent      Int       @default(0)
  /**
   * Eger kullanici sonradan RanksUp'a kayit oldu — userId burada
   */
  signupUserId     String?
  signupAt         DateTime?
  /**
   * Email locale (TR | EN)
   */
  locale           String    @default("tr")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  emailLogs PublicCitationEmailLog[]

  @@unique([email, domain])
  @@index([nextRetestAt, status])
  @@index([signupUserId])
  @@map("public_citation_subscribers")
}

// ──────────────────────────────────────────────────────────
// PUBLIC CITATION EMAIL LOG — gönderilen retest emailleri
// ──────────────────────────────────────────────────────────
model PublicCitationEmailLog {
  id              String    @id @default(cuid())
  subscriberId    String
  /**
   * Tip: welcome | retest_15d | retest_30d | retest_60d | retest_90d | signup_nudge | unsubscribe_ack
   */
  type            String
  /**
   * Email gonderim sirasinda üretilen citation check id'si (varsa)
   */
  citationCheckId String?
  /**
   * O anki delta — ornek: { before: 1, after: 3, totalProviders: 7 }
   */
  delta           Json?
  sentAt          DateTime  @default(now())
  /**
   * Resend webhook'tan gelen status: delivered/opened/clicked/bounced
   */
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  error           String?

  subscriber PublicCitationSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId, sentAt])
  @@index([type, sentAt])
  @@map("public_citation_email_logs")
}

// ═══════════════════════════════════════════════════════════════
//  PROMPT LAB + FAN-OUT — kullanicinin takip ettigi sorular ve
//  modelin arka planda urettigi alt sorgu agi
// ═══════════════════════════════════════════════════════════════

/**
 * Kullanicinin "beni bu soruda takip et" dedigi prompt.
 * Onceden probe sorgulari brain'den otomatik turuyordu ve kullanici
 * mudahale edemiyordu; artik takip seti birinci sinif veri.
 */
model GeoPrompt {
  id     String @id @default(cuid())
  siteId String

  /**
   * Dolu ise bu prompt bir mobil uygulamayi izler (App Prompt Lab) — probe'da
   * marka yerine app adi + store linki aranir. null = klasik site prompt'u.
   */
  trackedAppId String?

  text     String  @db.Text
  /**
   * informational | commercial | comparison | transactional | brand
   */
  intent   String  @default("informational")
  locale   String  @default("tr")
  /**
   * manual = kullanici yazdi, brain = brain'den import, suggested = AI onerdi
   */
  source   String  @default("manual")
  tags     Json? // ["pos", "kredi"]
  isActive Boolean @default(true)

  /**
   * Son calistirmadan ozet — liste ekraninda N+1 sorgu yapmamak icin
   */
  lastRunAt      DateTime?
  lastCitedCount Int       @default(0)
  lastTotalCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site       Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  trackedApp TrackedApp?      @relation(fields: [trackedAppId], references: [id], onDelete: Cascade)
  runs       GeoPromptRun[]
  fanouts    GeoFanoutQuery[]

  @@index([siteId, isActive])
  @@index([trackedAppId])
  @@map("geo_prompts")
}

/**
 * Modelin bir ana prompt'u cevaplarken arka planda urettigi alt sorgu.
 * Citation cogu zaman burada kazanilir/kaybedilir — kullanicinin yazdigi
 * soruda degil, modelin "X guvenilir mi", "X vs Y" seklinde actigi dallarda.
 */
model GeoFanoutQuery {
  id       String @id @default(cuid())
  promptId String
  siteId   String

  text        String  @db.Text
  /**
   * reviews | trust | comparison | pricing | alternatives | howto | local | spec
   */
  kind        String  @default("reviews")
  /**
   * Modelin bu dali uretme olasiligi tahmini 0..100
   */
  likelihood  Int     @default(50)
  /**
   * Fan-out agacindaki sira (0 = ilk dal)
   */
  rank        Int     @default(0)
  isActive    Boolean @default(true)
  /**
   * ai = LLM uretti, manual = kullanici ekledi
   */
  generatedBy String  @default("ai")

  createdAt DateTime @default(now())

  prompt GeoPrompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  runs   GeoPromptRun[]

  @@index([siteId])
  @@index([promptId, rank])
  @@map("geo_fanout_queries")
}

/**
 * Tek bir (prompt|fanout) x provider olcumu.
 * AiCitationSnapshot gunluk toplami tutar; bu tablo soru bazinda detay tutar
 * ki "hangi dalda kaybediyoruz" sorusu cevaplanabilsin.
 */
model GeoPromptRun {
  id       String  @id @default(cuid())
  siteId   String
  promptId String
  /**
   * Dolu ise bu olcum fan-out dalina ait; null ise ana prompt
   */
  fanoutId String?

  provider String
  date     DateTime @db.Date

  cited          Boolean @default(false)
  brandMentioned Boolean @default(false)
  /**
   * SORUNUN KENDISINDE marka adi geciyor mu?
   *
   * Sorguda markanin adi gecince asistanin markayi anmasi neredeyse
   * totolojik. (Sektorde "33 kat" diye dolasan sayi tek hesapli bir deneyin
   * cift sayimi cikti — yon dogru, sayi tasinmaz; defter analizi 2026-08.)
   * Ikisi ayni havuzda toplanirsa skor gorunurlugu degil prompt bilesimini olcer.
   *
   * Manset metrikleri (mentionRate, citationRate, sentiment, shareOfVoice)
   * yalnizca `false` satirlardan hesaplanir; `true` satirlar ayrica
   * "taninirlik" olarak raporlanir. bkz. audit/brand-in-query.ts
   */
  brandInQuery   Boolean @default(false)
  /**
   * Marka cevapta kacinci paragrafta gecti (1 = en ust)
   */
  position       Int?
  /**
   * positive | neutral | negative
   */
  sentiment      String?
  excerpt        String? @db.Text
  citedPages     Json?
  competitors    Json?

  createdAt DateTime @default(now())

  prompt GeoPrompt       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  fanout GeoFanoutQuery? @relation(fields: [fanoutId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
  @@index([promptId, date])
  @@index([fanoutId, date])
  /**
   * Esitlik kolonu (brandInQuery) range kolonundan (date) ONCE — b-tree'de
   * range'den sonraki esitlik seek'te kullanilamiyor, index bosa bakim
   * maliyeti oduyordu. Kullananlar: content-opportunity.derive (siteId eq +
   * brandInQuery eq + date range), looker mention-rate (aynisi). ai-kpis
   * markali/markasiz AYRIMINI JS'te yapar (queryMix icin iki taraf da lazim),
   * bu index'i kullanmaz — yorumu ona baglamak yanlisti.
   */
  @@index([siteId, brandInQuery, date])
  @@map("geo_prompt_runs")
}

// ═══════════════════════════════════════════════════════════════
//  MAYA-PARITY DALGASI (2026-08)
//  Agent Readiness (AXO) + Action Plans + Content Opportunities +
//  In-app Chat + Product Radar + Community Agent
// ═══════════════════════════════════════════════════════════════

/**
 * Agent Readiness (AXO) taramasi — domain'in AI AJANLARINA hazirlik skoru.
 * GEO Score Card "AI arama motorlarinda gorunurluk" olcerken bu tablo
 * "AI ajanlari siteni okuyabiliyor/kullanabiliyor mu" sorusuna cevap verir.
 * 4 seviye: quick-wins, groundwork, advanced, commerce.
 */
model AgentReadinessScan {
  id     String @id @default(cuid())
  siteId String

  overallScore Int // 0-100
  status       String // ready | mostly_ready | needs_work | not_ready
  // Skor metodolojisi surumu — 1: 2026-08 oncesi; 2: user-triggered botlar
  // stance skorundan cikti, llms.txt low, puansiz bilgi kontrolleri (bkz. migration)
  scoreVersion Int    @default(1)

  /**
   * [{ id, title, score, maxScore, checks: [{ id, name, ok, impact,
   *    statusText, howTo, agentPrompt, audit: [{ step, detail, ok }] }] }]
   */
  levels Json

  // robots.txt AI stance ozeti — "10 allow / 4 block", "23/27 ajan girebilir"
  robotsAiStance Json? // { allow, block, unspecified, bots: [{ name, stance }] }
  agentsAllowed  Int?
  agentsTotal    Int?

  // "Next up to fix" chip'leri — en yuksek etkili eksikler
  nextUpToFix Json? // [{ checkId, name }]

  ranAt      DateTime @default(now())
  durationMs Int?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, ranAt])
  @@map("agent_readiness_scans")
}

/**
 * Action Plan — tum modullerden (audit, GEO, AXO, ASO, ads, citation, chat)
 * "Aksiyon Planina Ekle" ile toplanan is listesi. Urunu rapordan is
 * yonetimine cevirir (Maya Action Plans karsiligi).
 */
model ActionPlanItem {
  id     String @id @default(cuid())
  siteId String

  title       String
  description String? @db.Text

  /** audit | geo | agent_readiness | citation | prompt_lab | aso | ads | qa | chat | product_radar | community | manual */
  source    String  @default("manual")
  /** Kaynak kaydin id'si (check id, prompt id, opportunity id...) */
  sourceRef String?

  impact String @default("medium") // high | medium | low
  effort String @default("medium") // easy | medium | hard
  status String @default("todo") // todo | in_progress | done | dismissed

  dueAt  DateTime?
  doneAt DateTime?
  meta   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([siteId, source])
  @@map("action_plan_items")
}

/**
 * Content Opportunity — kapali dongunun kalbi.
 * Prompt Lab'de KAYBEDILEN sorgu / review temasi / radar boslugu buraya
 * "icerik firsati" olarak duser; makale uretilir; yayin sonrasi ayni prompt
 * yeniden olculur ve delta buraya yazilir. (Maya Forge / Content Opportunity)
 */
model ContentOpportunity {
  id     String @id @default(cuid())
  siteId String

  /** prompt = Prompt Lab kaybi, reviews = ASO review temasi, radar = product radar, manual */
  source   String  @default("prompt")
  promptId String? // GeoPrompt kaynagi (source=prompt ise)
  fanoutId String?

  title String @db.Text // onerilen icerik basligi
  query String @db.Text // kaybedilen/tetikleyen sorgu

  /** LOST = hic gorunmuyor, WEAK = kismi, MISSING = veri yok, WON = kazanildi */
  coverage      String @default("LOST")
  providersLost Json? // ["openai", "gemini"]
  score         Int    @default(0) // onceliklendirme 0-100

  /** OPEN | PLANNED | GENERATED | PUBLISHED | REMEASURED | DISMISSED */
  status    String  @default("OPEN")
  articleId String?

  remeasuredAt    DateTime?
  /** { before: { cited, total }, after: { cited, total }, wonProviders: [...] } */
  remeasureResult Json?
  meta            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([siteId, coverage])
  @@index([promptId])
  @@map("content_opportunities")
}

/**
 * In-app Chat — kullanicinin kendi verisi uzerinde konusan asistan.
 * Tool-calling ile MCP tool registry'sini paylasir (tek kaynak).
 */
model ChatConversation {
  id     String  @id @default(cuid())
  siteId String
  userId String
  title  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([siteId, updatedAt])
  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String @id @default(cuid())
  conversationId String

  role    String // user | assistant
  content String @db.LongText

  /** Asistanin bu mesajda kullandigi tool cagrilari: [{ name, input, resultSummary }] */
  toolCalls Json?
  /** Mesaji tetikleyen skill preset'i (weekly-plan, visibility-report, ...) */
  skill     String?
  costUsd   Decimal? @db.Decimal(10, 4)

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/**
 * Product Radar — AI asistanlar kullanicinin kategorisinde HANGI urunleri
 * oneriyor? Marka listede mi, kacinci sirada? (Maya Product Radar karsiligi)
 */
model ProductRadarSnapshot {
  id     String @id @default(cuid())
  siteId String

  date     DateTime @db.Date
  provider String // anthropic | openai | gemini | perplexity | ...
  category String // sorgunun kategorisi (site.niche tabanli)
  query    String @db.Text

  /** [{ name, url?, rank, isBrand }] — cevaptaki oneri listesi */
  products    Json
  brandListed Boolean @default(false)
  brandRank   Int?

  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
  @@index([siteId, provider, date])
  @@map("product_radar_snapshots")
}

/**
 * Community Opportunity — Reddit/Quora/HARO'da tespit edilen soru +
 * AI taslak cevap + durum akisi. CommunityOutreachService'in kalici hali.
 */
model CommunityOpportunity {
  id     String @id @default(cuid())
  siteId String

  platform  String  @default("reddit") // reddit | quora | haro | twitter
  url       String  @db.Text
  title     String  @db.Text
  subreddit String?
  snippet   String? @db.Text

  relevance  Int     @default(50) // brandFitScore 0-100
  draftReply String? @db.Text

  /** NEW | DRAFTED | APPROVED | POSTED | IGNORED */
  status   String    @default("NEW")
  postedAt DateTime?
  meta     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@map("community_opportunities")
}

// ═══════════════════════════════════════════════════════════════
//  LIVE CRAWLER EVENTS (2026-08) — istek bazli ham AI bot ziyareti
//
//  AiCrawlerHit GUNLUK toplam tutar (grafik/KPI); bu tablo HAM satir
//  tutar ("1sn once GPTBot /blog/x'i cekti"). Kaynak: Cloudflare Worker,
//  WordPress eklentisi veya nginx log ajani → POST /api/tracker/events.
//  Retention: 60 gun (purge cron) — canli akis + kisa vadeli adli analiz.
// ═══════════════════════════════════════════════════════════════

model CrawlerHitEvent {
  id     String @id @default(cuid())
  siteId String

  ts     DateTime @default(now())
  bot    String // GPTBot | ChatGPT-User | ClaudeBot | ...
  path   String   @db.VarChar(1000)
  status Int      @default(200)

  /**
   * true = on-demand fetcher (ChatGPT-User, OAI-SearchBot, Perplexity-User,
   * Claude-Web/Claude-User): gercek bir kullanicinin AI sohbeti sirasinda
   * sayfa CANLI cekildi — "su anda bir cevabin icinde kullanildin" sinyali.
   */
  isCiteFetch Boolean @default(false)

  /** worker (Cloudflare) | wp (WordPress eklentisi) | log (nginx ajani) | beacon */
  source String @default("worker")
  meta   Json?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, ts])
  @@index([siteId, isCiteFetch, ts])
  @@index([ts])
  @@map("crawler_hit_events")
}

// ═══════════════════════════════════════════════════════════════
//  INTEL (2026-08) — sektor istihbarati: GEO/SEO/ASO dunyasinda
//  ne degisti, hangi iddia dogru, RanksUp'in nesini etkiliyor?
//
//  Akis:  IntelSource (katalog) → IntelItem (ham yayin, triage'li)
//         → IntelEvidence (yayindan cikarilan kanit) → IntelClaim
//         (iddia defteri, durum: CONFIRMED/CONTESTED/MYTH/...)
//         → IntelDigest (gunluk ozet)
//
//  NEDEN AYRI TABLOLAR: bir yayin birden fazla iddiaya kanit olabilir
//  (Ahrefs'in tek yazisi hem "llms.txt okunmuyor" hem "AI botlari
//  robots.txt'e uyuyor" iddialarini besler), ayni iddia da onlarca
//  yayindan beslenir. Cok-cok iliski IntelEvidence'ta cozulur.
// ═══════════════════════════════════════════════════════════════

model IntelSource {
  id   String @id @default(cuid())
  /** source-registry.ts'teki slug — upsert anahtari */
  key  String @unique
  name String

  /** rss | reddit | hn | x | github */
  kind   String
  /** feed URL'i, subreddit adi ya da arama sorgusu — KATALOG degeri */
  target String @db.Text
  /**
   * Panelden elle girilen sorgu. Doluysa `target` yerine BU kullanilir.
   *
   * NEDEN AYRI ALAN: syncCatalog() her senkronda `target`'i koddaki
   * INTEL_SOURCES'tan eziyor. Elle duzenleme dogrudan `target`'a yazilsaydi
   * bir sonraki acilista sessizce geri alinirdi. Override ayri durdugu icin
   * senkron ona dokunmuyor; bosaltilinca katalog degerine geri donulur.
   */
  targetOverride String? @db.Text

  /** official | primary-research | practitioner | news | community */
  tier          String
  /** IntelTopic listesi (JSON string dizisi) */
  topics        Json
  /** Kaynak on-agirligi 0-100 — kanit skorunun carpani */
  weight        Int     @default(50)
  intervalHours Int     @default(24)
  enabled       Boolean @default(true)
  note          String? @db.Text

  lastFetchedAt DateTime?
  /** Ust uste hata sayaci — esigi asinca otomatik devre disi kalir */
  failCount     Int       @default(0)
  lastError     String?   @db.Text

  items IntelItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, lastFetchedAt])
  @@map("intel_sources")
}

model IntelItem {
  id       String @id @default(cuid())
  sourceId String

  /** Icerik parmak izi (normalize URL + baslik) — ayni yazi birden fazla feed'de cikabilir */
  fingerprint String @unique

  url         String    @db.Text
  title       String    @db.Text
  author      String?
  publishedAt DateTime?
  /** Feed ozeti — triage bunun uzerinden calisir, tam metin cekilmez */
  summary     String?   @db.Text
  /** Analiz asamasinda cekilen tam metin (yalnizca triage'i gecenler) */
  fullText    String?   @db.LongText

  /** PENDING | RELEVANT | IRRELEVANT | ANALYZED | FAILED */
  status String @default("PENDING")

  /** Triage ciktisi: 0-100 alaka puani */
  relevance  Int?
  /** Triage ciktisi: IntelTopic listesi */
  topics     Json?
  /** Triage'in tek cumlelik gerekcesi — yanlis elemeleri denetlemek icin */
  triageNote String? @db.Text

  /** Toplulukta ilgi olcusu: HN puani, Reddit upvote, X begeni */
  engagement Int?

  meta Json?

  source    IntelSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  evidences IntelEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, relevance])
  @@index([sourceId, createdAt])
  @@index([publishedAt])
  @@map("intel_items")
}

model IntelClaim {
  id String @id @default(cuid())

  /** Iddianin kanonik ifadesi — tek cumle, dogrulanabilir bicimde */
  statement String @db.Text
  /** Eslestirme anahtari: normalize edilmis konu ifadesi */
  slug      String @unique

  /** IntelTopic listesi */
  topics Json

  /** CONFIRMED | CONTESTED | EMERGING | MYTH | STALE */
  status        String @default("EMERGING")
  /** -1..+1 — destek/karsit kefelerinin normalize farki */
  confidence    Float  @default(0)
  supportWeight Int    @default(0)
  refuteWeight  Int    @default(0)

  /** Bu iddia RanksUp'in NESINI etkiliyor (citation-scoring, agent-readiness, ...) */
  productAreas Json?
  /** Ekip icin tek cumlelik kullanim talimati */
  guidance     String? @db.Text
  /** OPEN | PLANNED | APPLIED | REJECTED — bulgunun urun tarafinda kapanmasi */
  actionStatus String  @default("OPEN")
  actionNote   String? @db.Text

  evidences IntelEvidence[]

  firstSeenAt    DateTime  @default(now())
  lastEvidenceAt DateTime?
  /**
   * HUKMUN gercekten degistigi an — status/confidence/agirlik alanlarindan
   * biri baska bir degere yazildiginda guncellenir.
   *
   * NEDEN updatedAt YETMIYOR: recomputeAll() her gece tum defteri yeniden
   * tartiyor ve deger degismese bile update() cagirdigi icin @updatedAt her
   * satirda taze goruniyordu. Ozet "donem icinde degisen iddialar" diye
   * updatedAt ile suzunce 745 iddianin tamami eslesiyor, gunluk ozet
   * defterin tamamini basiyordu. updatedAt teknik denetim alani olarak
   * birakildi; urun anlami bu alanda.
   */
  lastChangedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, confidence])
  @@index([actionStatus])
  /** Ozet "bu donemde ne degisti" sorgusu */
  @@index([lastChangedAt])
  @@map("intel_claims")
}

model IntelEvidence {
  id      String @id @default(cuid())
  claimId String
  itemId  String

  /** official-doc | large-n-study | controlled-test | case-study | expert-opinion | anecdote | speculation */
  grade  String
  /** supports | refutes | mixed */
  stance String

  /** Yayindan birebir alinti — kanit zinciri denetlenebilir olsun diye */
  quote      String? @db.Text
  /** Calismanin orneklem buyuklugu; large-n-study dogrulamasinda kullanilir */
  sampleSize Int?
  /** Hesaplanmis etkili agirlik (grade x kaynak x tazelik) */
  weight     Int     @default(0)

  claim IntelClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  item  IntelItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /** Ayni yayin ayni iddiaya iki kez kanit olamaz */
  @@unique([claimId, itemId])
  @@index([claimId, weight])
  @@map("intel_evidence")
}

model IntelDigest {
  id String @id @default(cuid())

  /** daily | weekly */
  period String
  /** Kapsanan donemin bitis gunu (UTC gun basi) */
  date   DateTime

  /** Markdown ozet — e-posta ve panelde ayni govde kullanilir */
  body  String @db.LongText
  /** Ozet istatistikleri: kac yayin tarandi, kac iddia degisti vs. */
  stats Json?

  emailedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([period, date])
  @@index([date])
  @@map("intel_digests")
}

// ═══════════════════════════════════════════════════════════════
//  RAPOR — DONDURULMUS SONUC
// ═══════════════════════════════════════════════════════════════

/**
 * Kullanicinin calistirdigi bir raporun KALICI kaydi.
 *
 * NEDEN TABLO GEREKIYOR — turetilmis hesap "gecmis" olamaz:
 * ReportsService.overview() her cagrida sifirdan hesapliyor ve altindaki
 * kaynaklarin bir kismi degisiyor/siliniyor. Ayni rapor iki hafta sonra
 * acildiginda FARKLI sayi gosterir:
 *   - AdCampaign metrik kolonlarini cron uzerine yaziyor (gunluk snapshot yok)
 *   - AiCrawlerHit / CrawlerHitEvent belirli sure sonra temizleniyor
 *   - User.articlesUsedThisMonth ve aiCostThisMonthUsd her ay sifirlaniyor
 * Musteriye "Temmuz raporu" diye gonderilen bir belgenin Eylul'de baska
 * rakam gostermesi kabul edilemez. Bu yuzden rapor URETILDIGI ANDA
 * dondurulur ve bir daha hesaplanmaz.
 *
 * TEK TABLO, DORT ALAN: SEO / GEO / ASO / ASA ayri tablolara bolunmedi.
 * Kullanici "bu proje ne kadar buyudu" diye soruyor; cevap tek bir belge
 * olmali. ASO ve ASA da site eksenine toplanabiliyor
 * (AppRanking -> TrackedAppKeyword -> TrackedApp.siteId), yani ayirmayi
 * gerektiren bir kisit yok.
 */
model SiteReport {
  id     String  @id @default(cuid())
  siteId String
  /// Raporu kim calistirdi. Kullanici silinirse rapor kalir (SetNull yok:
  /// alan opsiyonel ve iliski tanimlanmadi — kimlik yalnizca bilgi amacli).
  userId String?

  /// week | month | year | custom
  period      String   @db.VarChar(16)
  periodStart DateTime
  periodEnd   DateTime

  /// manual | cron | api — Audit.trigger ile ayni gerekce: otomatik uretilen
  /// raporlar kullanicinin "calistirdigi rapor" sayisina karismamali.
  trigger String @default("manual") @db.VarChar(16)

  /**
   * DONDURULMUS tam govde. Sekli: { seo, geo, aso, asa, is, meta }.
   * Olculemeyen her bolum `{ olculemedi: true, neden: "..." }` tasir —
   * sifir YAZILMAZ, cunku sifir sahte bir dusus gibi okunur.
   */
  data Json

  // ── Liste kolonlari ────────────────────────────────────────────
  // Gecmis listesini data'yi parse etmeden cizebilmek icin denormalize.
  // Ayni gerekce AuditService.getHistory'nin `checks` Json'unu bilerek
  // cekmemesiyle ayni: liste satiri basina yuzlerce KB parse edilmemeli.
  // Hepsi NULLABLE cunku "olculemedi" ile "sifir" ayri seyler.
  seoScore          Int?
  geoScore          Int?
  aiVisibility      Int?
  asoAvgRank        Float?
  clicks            Int      @default(0)
  impressions       Int      @default(0)
  articlesPublished Int      @default(0)
  costUsd           Decimal  @default(0) @db.Decimal(10, 4)

  status     String    @default("READY") @db.VarChar(16)
  error      String?   @db.Text
  durationMs Int?
  generatedAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, generatedAt])
  @@index([siteId, period, periodStart])
  @@map("site_reports")
}

// ═══════════════════════════════════════════════════════════════
//  UYGULANAN DUZELTMELER
// ═══════════════════════════════════════════════════════════════

/**
 * Siteye GERCEKTEN uygulanan bir duzeltmenin kalici kaydi.
 *
 * NEDEN GEREKIYOR: uc ayri servis siteye degisiklik yaziyordu ve HICBIRI iz
 * birakmiyordu:
 *   - snippet-applier.service.ts  meta/OG/JSON-LD'yi yayin hedefine yaziyor
 *   - static-html-fixer.service.ts statik HTML'e yaziyor
 *   - auto-fix.service.ts          en son Audit satirinin fixesApplied
 *     alaninin UZERINE yaziyor; ikinci kosum birincinin izini siliyor
 *
 * Sonuc: "bu donemde kac duzeltme uygulandi" sorusu cevaplanamiyordu ve
 * rapora "N sayfaya meta uygulandi" yazmak uydurma olurdu. Bu tablo o
 * boslugu kapatir; rapor artik sayabilir.
 *
 * Neden Audit'e kolon degil de ayri tablo: bir tarama ile bir duzeltme
 * arasinda 1-N iliski var, duzeltmeler taramadan bagimsiz da uygulanabiliyor
 * (kullanici tek bir sayfayi elle duzeltebiliyor) ve geri alma zamani da
 * saklanmali.
 */
model AppliedFix {
  id     String  @id @default(cuid())
  siteId String
  /// Elle uygulandiysa kim uyguladi; sistem uygulamasinda null.
  userId String?

  /// snippet | static_html | auto_fix — hangi servis uyguladi
  kind String @db.VarChar(24)
  /// meta_title | canonical | jsonld_article | sitemap_xml ...
  fixType String @db.VarChar(48)
  /// Hangi sayfaya/kaynaga uygulandi (URL ya da dosya yolu)
  target String? @db.Text

  /// APPLIED | FAILED | REVERTED
  status String @default("APPLIED") @db.VarChar(12)
  /// Basarisizsa nedeni — sessiz basarisizlik "uygulandi" sayilmasin
  error String? @db.Text

  /// Uygulanan degerin ozeti. Tam govde saklanmiyor: sayfa HTML'i buyuk
  /// olabiliyor ve raporun ihtiyaci olan sey ne yazildigi degil, ne tur bir
  /// duzeltmenin yapildigi.
  detail Json?

  /// Hangi yayin hedefi uzerinden gitti (wordpress, ftp...)
  adapter String? @db.VarChar(32)

  appliedAt  DateTime  @default(now())
  revertedAt DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, appliedAt])
  @@index([siteId, status, appliedAt])
  @@map("applied_fixes")
}
